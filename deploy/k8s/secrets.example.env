# What scripts/k8s-secrets.sh reads. Copy to .secrets/k8s.env (git-ignored) and
# fill in the lines below; the script generates everything else (database
# passwords, signing keys) and writes it back to that file, so keep the file:
# losing it makes the cluster's Secrets unrecreatable. KEY=value, no quoting.
#
#   scripts/k8s-secrets.sh --context kind-shogun --namespace shogun

# The origin the browser uses. Port-forward the web app to this port.
TORII_PUBLIC_URL=http://localhost:3000

# Sign in with Google. Register ${TORII_PUBLIC_URL}/auth/callback as the redirect URI.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Comma-separated Google accounts allowed to sign in.
TORII_ALLOWED_EMAILS=you@example.com

# Connect Gmail (Gmail API enabled). Register TSUBAME_GMAIL_REDIRECT_URL as the redirect URI.
TSUBAME_GMAIL_CLIENT_ID=replace-me.apps.googleusercontent.com
TSUBAME_GMAIL_CLIENT_SECRET=replace-me
TSUBAME_GMAIL_REDIRECT_URL=http://localhost:3000/mail/callback

# Optional outside production: drafts and GitHub sync fail with a clear reason without them.
ANTHROPIC_API_KEY=
KATANA_GITHUB_USER=
# Read-only access to your repositories is enough.
KATANA_GITHUB_TOKEN=

# Private ghcr.io images: a GitHub user and a token with read:packages. When both are
# set, scripts/k8s-secrets.sh creates the pull secret "ghcr" that the charts use.
GHCR_USER=
GHCR_TOKEN=
