# Every Helm release of a Shogun cluster, its values and its install order.
# `needs` orders the releases, so one apply installs a cluster from scratch:
#
#   bootstrap  namespaces, sealed-secrets controller
#   secrets    the sealed Secrets committed for the environment
#   platform   cert-manager, monitoring (kube-prometheus-stack), monitoring-extras
#   ingress    ClusterIssuers, Traefik (kind) or the k3s Traefik redirect
#   data       postgres
#   apps       soroban, then the other services and web
#
# Normally run through make (deploy, deploy-plan, deploy-status). By hand:
#   helmfile -e <staging|production> --kube-context <ctx> apply --concurrency 1
# One phase or app: -l phase=<phase> or -l name=<app>.
# Override an image tag without editing values: --state-values-set tags.kagami=1.2.3
# By hand, also pass --state-values-set kubeContext=<ctx> (see crds below).
#
# Until secrets/<env>/ is sealed (make seal), only bootstrap is declared: the
# rest reads Secrets that do not exist yet.
#
# Each environment is its own cluster with its own sealing key. Paths are
# relative to this file.

repositories:
  - name: sealed-secrets
    url: https://bitnami.github.io/sealed-secrets
  - name: jetstack
    url: quay.io/jetstack/charts
    oci: true
  - name: prometheus-community
    url: ghcr.io/prometheus-community/charts
    oci: true
  - name: traefik
    url: ghcr.io/traefik/helm
    oci: true

environments:
  staging:
    values:
      - tags: {}
        kubeContext: ""
  production:
    values:
      - tags: {}
        kubeContext: ""

---
helmDefaults:
  wait: true
  timeout: 300

{{- $env := .Environment.Name }}
{{- $tags := .Values.tags }}
{{- /* CRDs already on the cluster. A release adopts objects once applied with
       kubectl only when its kind exists: then there may be objects to adopt and
       the take-ownership lookup in helm diff can map the kind. On a fresh
       cluster the CRD arrives in the same apply, so there is nothing to adopt. */}}
{{- $crds := exec "kubectl" (list "--context" .Values.kubeContext "get" "crds" "-o" "name") }}
{{- /* Helm 4 applies server-side, and kubectl-client-side-apply still owns the
       adopted fields, so adopting also forces those conflicts over to Helm. */}}
{{- $adoptSealed := contains "/sealedsecrets.bitnami.com" $crds }}
{{- $adoptIssuers := contains "/clusterissuers.cert-manager.io" $crds }}
{{- $adoptTraefik := contains "/helmchartconfigs.helm.cattle.io" $crds }}
{{- /* k3s ships Traefik and the HelmChartConfig CRD; any other cluster (kind)
       gets Traefik from the release below. */}}
{{- $k3s := $adoptTraefik }}
{{- $sealed := printf "deploy/infrastructure/sealed-secrets/secrets/%s" $env }}

releases:
  # ---- bootstrap -------------------------------------------------------------
  # Namespace objects are cluster-wide; the release record lives in kube-system.
  - name: namespaces
    namespace: kube-system
    chart: ./deploy/charts/namespaces
    # cert-manager was created by its own release's createNamespace before it
    # moved here; adopt it (a no-op on a fresh cluster).
    takeOwnership: true
    labels:
      phase: bootstrap
    values:
      - deploy/infrastructure/namespaces/values.yaml
      - deploy/infrastructure/namespaces/values-{{ $env }}.yaml

  - name: sealed-secrets
    namespace: kube-system
    chart: sealed-secrets/sealed-secrets
    version: 2.20.0
    labels:
      phase: bootstrap
    values:
      - deploy/infrastructure/sealed-secrets/values.yaml
{{- if isDir $sealed }}

  # ---- secrets ---------------------------------------------------------------
  # The plain manifest directories below become charts through helmfile. They
  # were once applied with kubectl; takeOwnership adopts what already exists
  # once the kind is installed (see $crds above).
  - name: secrets
    namespace: kube-system
    chart: ./{{ $sealed }}
    takeOwnership: {{ $adoptSealed }}
    forceConflicts: {{ $adoptSealed }}
    # The SealedSecret CRD arrives with the controller in the same apply.
    disableValidationOnInstall: true
    labels:
      phase: secrets
    needs:
      - kube-system/namespaces
      - kube-system/sealed-secrets

  # ---- platform --------------------------------------------------------------
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.21.2
    labels:
      phase: platform
    needs:
      - kube-system/namespaces
    values:
      - deploy/infrastructure/cert-manager/values.yaml

  # Release name "monitoring" gives the Service names monitoring-grafana and
  # monitoring-kube-prometheus-prometheus that docs/deploy.md uses.
  - name: monitoring
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: 92.3.0
    # The stack pulls several images on a fresh node.
    timeout: 600
    # Its own CRDs (Prometheus, ServiceMonitor, ...) arrive with this release,
    # so a diff on a fresh cluster cannot validate against them yet.
    disableValidationOnInstall: true
    labels:
      phase: platform
    needs:
      - kube-system/namespaces
      - kube-system/secrets
    values:
      - deploy/infrastructure/monitoring/kube-prometheus-stack/values.yaml
      - deploy/infrastructure/monitoring/kube-prometheus-stack/values-{{ $env }}.yaml

  - name: monitoring-extras
    namespace: monitoring
    chart: ./deploy/charts/monitoring-extras
    # Its PrometheusRule CRD arrives with monitoring in the same apply.
    disableValidationOnInstall: true
    labels:
      phase: platform
    needs:
      - monitoring/monitoring

  # ---- ingress ---------------------------------------------------------------
  - name: cluster-issuers
    namespace: cert-manager
    chart: ./deploy/infrastructure/cert-manager/issuers
    takeOwnership: {{ $adoptIssuers }}
    forceConflicts: {{ $adoptIssuers }}
    disableValidationOnInstall: true
    labels:
      phase: ingress
    needs:
      - cert-manager/cert-manager
      # cloudflare-api-token for DNS-01.
      - kube-system/secrets

  - name: traefik-config
    namespace: kube-system
    chart: ./deploy/infrastructure/traefik/k3s-config
    takeOwnership: {{ $adoptTraefik }}
    forceConflicts: {{ $adoptTraefik }}
    labels:
      phase: ingress

  # Traefik itself where k3s does not bundle it (kind): hostPort 80 and 443 on
  # the control-plane node, where kind maps the host's ports.
  - name: traefik
    namespace: kube-system
    chart: traefik/traefik
    version: 41.7.1
    installed: {{ not $k3s }}
    labels:
      phase: ingress
    values:
      - deploy/infrastructure/traefik/values.yaml

  # ---- data ------------------------------------------------------------------
  - name: postgres
    namespace: shogun
    chart: ./deploy/charts/postgres
    timeout: 180
    labels:
      phase: data
    needs:
      - kube-system/namespaces
      - kube-system/secrets
    values:
      - deploy/infrastructure/postgres/values.yaml
      - deploy/infrastructure/postgres/values-{{ $env }}.yaml

  # ---- apps ------------------------------------------------------------------
  # soroban first: the other services reserve LLM cost with it. An app without
  # values-<env>.yaml is not part of that environment (web has no production
  # values yet).
{{- range $name := list "soroban" "kagami" "fude" "tsubame" "taiko" "dojo" "katana" "shinobi" "sensei" "torii" "web" }}
{{- if isFile (printf "deploy/apps/%s/values-%s.yaml" $name $env) }}
  - name: {{ $name }}
    namespace: shogun
    chart: ./deploy/charts/microservice
    # ServiceMonitor and Certificate kinds may not be installed yet on a fresh cluster.
    disableValidationOnInstall: true
    labels:
      phase: apps
    needs:
      - shogun/postgres
      {{- if ne $name "soroban" }}
      - shogun/soroban
      {{- end }}
    values:
      - deploy/apps/common.yaml
      - deploy/apps/{{ $name }}/values.yaml
      - deploy/apps/{{ $name }}/values-{{ $env }}.yaml
      {{- with index $tags $name }}
      - image:
          tag: {{ . | quote }}
      {{- end }}
{{- end }}
{{- end }}
{{- end }}
