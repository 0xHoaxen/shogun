# Copy to .env for local runs. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=info
DATABASE_URL=
GRPC_PORT=9090
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local compose stack (make up). Dev-only placeholders; never reuse them elsewhere.
POSTGRES_PASSWORD=local-dev-postgres
# At least 32 bytes. Generate your own with: openssl rand -hex 32
IDENTITY_SIGNING_KEY=local-dev-identity-signing-key-0123456789abcdef
TORII_DB_PASSWORD=local-dev-torii
# torii login with Google. Create an OAuth client in Google Cloud Console and
# register ${TORII_PUBLIC_URL}/auth/callback as its redirect URI. The values
# below let the stack start; login only works with your real client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Comma-separated Google accounts allowed to sign in. Everyone else is refused.
TORII_ALLOWED_EMAILS=you@example.com
# The origin the browser uses: the web app, which proxies /api and /auth to torii.
TORII_PUBLIC_URL=http://localhost:3000
KAGAMI_DB_PASSWORD=local-dev-kagami
TSUBAME_DB_PASSWORD=local-dev-tsubame
FUDE_DB_PASSWORD=local-dev-fude
TAIKO_DB_PASSWORD=local-dev-taiko
DOJO_DB_PASSWORD=local-dev-dojo
KATANA_DB_PASSWORD=local-dev-katana
SHINOBI_DB_PASSWORD=local-dev-shinobi
SENSEI_DB_PASSWORD=local-dev-sensei
SOROBAN_DB_PASSWORD=local-dev-soroban
# Host port for the compose Postgres (default 15432).
# POSTGRES_PORT=15432
