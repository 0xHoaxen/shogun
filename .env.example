# Copy to .env for local runs. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=info
DATABASE_URL=
GRPC_PORT=9090
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local compose stack (make up). Dev-only placeholders; never reuse them elsewhere.
POSTGRES_PASSWORD=local-dev-postgres
# At least 32 bytes. Generate your own with: openssl rand -hex 32
IDENTITY_SIGNING_KEY=local-dev-identity-signing-key-0123456789abcdef
TORII_DB_PASSWORD=local-dev-torii
# torii login with Google. Create an OAuth client in Google Cloud Console and
# register ${TORII_PUBLIC_URL}/auth/callback as its redirect URI. The values
# below let the stack start; login only works with your real client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Comma-separated Google accounts allowed to sign in. Everyone else is refused.
TORII_ALLOWED_EMAILS=you@example.com
# The origin the browser uses: the web app, which proxies /api and /auth to torii.
TORII_PUBLIC_URL=http://localhost:3000
# Leave unset to use Google. The e2e overlay (deploy/compose/compose.e2e.yaml)
# points torii at a stub provider instead.
# GOOGLE_ISSUER_URL=https://accounts.google.com
KAGAMI_DB_PASSWORD=local-dev-kagami
TSUBAME_DB_PASSWORD=local-dev-tsubame
# tsubame encrypts mail OAuth tokens with this master key (base64, 32 bytes).
# Required. The value is a dev-only placeholder; generate your own with:
#   openssl rand -base64 32
# Losing it makes every stored mail token unreadable, so connect mail again.
TSUBAME_TOKEN_MASTER_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Names the master key so keys can be rotated.
TSUBAME_TOKEN_KEY_ID=tsubame-1
# Connect Gmail: create an OAuth client in Google Cloud Console with the Gmail
# API enabled, and register TSUBAME_GMAIL_REDIRECT_URL as its redirect URI.
# The values below let the stack start; connecting mail needs your real client.
TSUBAME_GMAIL_CLIENT_ID=replace-me.apps.googleusercontent.com
TSUBAME_GMAIL_CLIENT_SECRET=replace-me
TSUBAME_GMAIL_REDIRECT_URL=http://localhost:3000/mail/callback
FUDE_DB_PASSWORD=local-dev-fude
# fude writes drafts with Claude. Leave empty to start the stack without it:
# drafts then fail with a clear reason. Required when ENVIRONMENT=production.
ANTHROPIC_API_KEY=
# Test only: send Claude calls (fude and tsubame) to a stub instead of Anthropic.
# ANTHROPIC_BASE_URL=
# Test only: send tsubame's Gmail calls to a stub instead of Google.
# TSUBAME_GMAIL_API_BASE=
# TSUBAME_GMAIL_AUTH_URL=
# TSUBAME_GMAIL_TOKEN_URL=
# fude signs approvals with this Ed25519 seed (base64, 32 bytes). Required. The
# value below is a dev-only placeholder; generate your own: openssl rand -base64 32
FUDE_HANKO_SIGNING_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Names the key in each token so keys can be rotated.
FUDE_HANKO_KEY_ID=fude-1
# tsubame sends mail only for approvals signed by one of these public keys:
# comma-separated key-id=base64 pairs. This is the public half of the dev seed
# above; when you change FUDE_HANKO_SIGNING_KEY, set the matching public key.
TSUBAME_HANKO_VERIFY_KEYS=fude-1=A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=
TAIKO_DB_PASSWORD=local-dev-taiko
DOJO_DB_PASSWORD=local-dev-dojo
KATANA_DB_PASSWORD=local-dev-katana
SHINOBI_DB_PASSWORD=local-dev-shinobi
SENSEI_DB_PASSWORD=local-dev-sensei
SOROBAN_DB_PASSWORD=local-dev-soroban
# Host port for the compose Postgres (default 15432).
# POSTGRES_PORT=15432
