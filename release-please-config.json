{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "tag-separator": "/",
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "packages": {
    "pkg": {
      "component": "pkg"
    },
    "gen/go": {
      "component": "gen/go"
    },
    "services/torii": {
      "component": "services/torii"
    },
    "services/kagami": {
      "component": "services/kagami"
    },
    "services/tsubame": {
      "component": "services/tsubame"
    },
    "services/fude": {
      "component": "services/fude"
    },
    "services/taiko": {
      "component": "services/taiko"
    },
    "services/dojo": {
      "component": "services/dojo"
    },
    "services/katana": {
      "component": "services/katana"
    },
    "services/shinobi": {
      "component": "services/shinobi"
    },
    "services/sensei": {
      "component": "services/sensei"
    },
    "services/soroban": {
      "component": "services/soroban"
    }
  }
}
